# Copy to `.env.local` and fill in. Anything VITE_* is embedded in the client
# bundle, so never put a secret here.

# Where the enquiry form POSTs JSON. Leave blank and the form falls back to
# composing an email in the visitor's own mail client, which works with no
# backend at all.
#
# The endpoint must be one you control. Do not point this at another company's
# server: it would send your visitors' names, emails and phone numbers to a
# business they never agreed to share them with.
#
# VITE_ENQUIRY_ENDPOINT=https://your-domain.com/api/enquiry
